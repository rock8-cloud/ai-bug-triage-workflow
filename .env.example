# --- rock8router: the model gateway (OpenAI-compatible) --------------------
# Not Rock8Cloud. This is the router in front of the LLMs — one key, one
# protocol, every model behind it. `r8_` tokens. It is what THIS app thinks
# with; see ROCK8CLOUD_* below for the platform the agents run on.
GATEWAY_BASE_URL=https://ai.rock8router.com/v1
GATEWAY_API_KEY=
# Routing IDs from your token's Models table. `bun run models` prints the live
# table; every id there is a candidate for `bun run eval`.
CHAT_MODEL=rock8router/gpt-4.1-mini
EMBEDDING_MODEL=rock8router/openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Postgres --------------------------------------------------------------
# `docker compose up -d` serves exactly this. One database for workflow run
# state, tickets, and the pgvector index.
DATABASE_URL=postgres://bugtriage:bugtriage@localhost:5489/bugtriage

# --- Service URLs ----------------------------------------------------------
# The three apps deploy as separate containers and find each other over HTTP.
# Both the custom UI and Studio point at the Mastra server through this.
MASTRA_URL=http://localhost:4111
# Browser origins allowed to call the server directly. Studio only — the custom
# UI talks to Mastra from its own server. Comma-separated; add the deployed
# Studio origin here. Cannot be `*`: Studio's auth bootstrap sends credentials.
CORS_ORIGINS=http://localhost:3001

# --- Knowledge base --------------------------------------------------------
DOCS_LLMS_URL=https://docs.rock8.cloud/llms-full.txt


# --- Rock8Cloud: the platform the coding agents run on ---------------------
# Not rock8router. This is the PaaS holding the repository — its agents clone,
# read and change code, and open pull requests. `vhk_` API keys.
# A scoped `vhk_` API key, not an OAuth session — the server holds
# this, so it must be a credential that belongs to the service, not to a person.
ROCK8CLOUD_API_URL=https://app.rock8.cloud
ROCK8CLOUD_API_KEY=
# Org test3 / project super-orbit-7cf / service orbital-capsule-4b6
ROCK8CLOUD_ORG_ID=HksAgr6SZxMaDYXyluCwRbYoQMxxGMy7
ROCK8CLOUD_SERVICE_ID=01a048ca-a810-748b-8db8-53dcb2e3facd
# From GET /api/agents/models. Blank = platform default.
ROCK8CLOUD_AGENT_MODEL_ID=

# --- Duplicate detection ---------------------------------------------------
# Above this similarity an incoming report is treated as already filed. High on
# purpose: filing a duplicate is cheap, closing a real report is not.
DUPLICATE_THRESHOLD=0.88

# How close a report must sit to a standing rule before memory shows it to the
# policy agent at all. A rule and a report are different kinds of text, so this
# is lower than the duplicate threshold; the agent decides whether it applies.
STANDING_RECALL_FLOOR=0.45

# --- Triage policy ---------------------------------------------------------
# The numbers the process decides on its own from. Change one, re-run the same
# report, watch the branch flip.
MAX_AUTOFIX_FILES=3
ANALYSIS_CONFIDENCE_FLOOR=0.6
DOCS_INTENT_THRESHOLD=0.52

# --- Slack (optional) --------------------------------------------------------
# With all three set, every report gets a thread in the channel, each gate
# posts a line as it finishes, and a report waiting on a person posts a card
# with Build / Backlog / Won't do buttons. A reply in the thread works too.
# Leave them unset and nothing changes: the web UI is the only front door.
# Create the app from the manifest in README.md, then copy the values from
# Basic Information > App Credentials and OAuth & Permissions.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# The channel to post new report threads into, e.g. C0123456789. Invite the bot.
SLACK_CHANNEL_ID=
